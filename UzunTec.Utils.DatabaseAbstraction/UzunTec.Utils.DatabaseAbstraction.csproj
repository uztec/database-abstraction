  <ItemGroup>
    <PackageReference Include="UzunTec.Utils.Common" Version="0.2.5" />
  </ItemGroup>

  <ItemGroup>
	  <None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>/</PackagePath>
	  </None>
      <None Include="db-abstraction-uztec.png">
		<Pack>True</Pack>
		<PackagePath></PackagePath>
      </None>
  </ItemGroup>

