<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<PackageId>UzunTec.DatabaseAbstraction</PackageId>
	<Version>10.0.1</Version>
	<Authors>Uzun Technology</Authors>
	<Company>Uzun Technology</Company>
	<RepositoryUrl>https://github.com/uztec/database-abstraction</RepositoryUrl> 
	<RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
